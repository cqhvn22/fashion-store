FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_USE_DB_AUTH=false
ARG VITE_USE_DB_CATALOG=false
ARG VITE_USE_DB_ORDERS=false
ARG VITE_USE_DB_AI=false
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_USE_DB_AUTH=$VITE_USE_DB_AUTH
ENV VITE_USE_DB_CATALOG=$VITE_USE_DB_CATALOG
ENV VITE_USE_DB_ORDERS=$VITE_USE_DB_ORDERS
ENV VITE_USE_DB_AI=$VITE_USE_DB_AI
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
